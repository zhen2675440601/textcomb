{
  "name": "@textcomb/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "generate:api": "openapi-typescript http://localhost:3000/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "js-yaml": "^4.3.0"
  }
}
